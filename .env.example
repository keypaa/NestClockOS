MISTRAL_API_KEY=your-key-here
NESTCLOCK_ROUTER_DIR=

# Wake word: 1 = always-on detector loop in the companion (0/absent = push-to-talk only)
NESTCLOCK_WAKE_WORD=1
# Model for openWakeWord: bundled stock model, or a path to a custom .onnx
# (e.g. my_custom_model/hey_pik_sel.onnx once trained). Leave unset for hey_jarvis_v0.1.
NESTCLOCK_WAKE_MODEL=hey_jarvis_v0.1
# Trigger sensitivity, 0.0-1.0 (default 0.5). Higher = fewer false accepts, more false rejects.
# NESTCLOCK_WAKE_THRESHOLD=0.5
